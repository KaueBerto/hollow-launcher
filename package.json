{
  "name": "hollow-launcher",
  "version": "2.9.1",
  "description": "Launcher Electron do AVERON SMP para Windows e Linux",
  "author": {
    "name": "AVERON SMP",
    "email": "kaueberto@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "desktopName": "averon-launcher.desktop",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "electron-updater": "6.8.9",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.hollowsmp.launcher",
    "productName": "Averon Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*.cjs",
      "renderer/**/*",
      "assets/averon-smp.png",
      "assets/end-background.png",
      "assets/averon.ico",
      "assets/launcher-music.mp3",
      "assets/Monocraft*.ttf",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/menu-bootstrap-manifest.json",
        "to": "assets/menu-bootstrap-manifest.json"
      },
      {
        "from": "assets/profile-defaults-manifest.json",
        "to": "assets/profile-defaults-manifest.json"
      },
      {
        "from": "assets/profile-defaults.zip",
        "to": "assets/profile-defaults.zip"
      },
      {
        "from": "assets/automodpack-5.0.0-rc.2.jar",
        "to": "assets/automodpack-5.0.0-rc.2.jar"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD-PARTY.txt",
        "to": "THIRD-PARTY.txt"
      },
      {
        "from": "assets/hollow-pack-preflight.jar",
        "to": "assets/hollow-pack-preflight.jar"
      },
      {
        "from": "java/preflight",
        "to": "preflight-source"
      },
      {
        "from": "assets/averonsync-mc1.21.1-neoforge-4.0.6-averonsync.0.15.jar",
        "to": "assets/averonsync-mc1.21.1-neoforge-4.0.6-averonsync.0.15.jar"
      },
      {
        "from": "vendor/averonsync/AveronSync-0.15-source.zip",
        "to": "licenses/AveronSync-0.15-source.zip"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/averon.ico",
      "artifactName": "AveronSMP-Launcher-Setup-${version}.exe",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "assets/averon-smp.png",
      "syncDesktopName": true,
      "artifactName": "AveronSMP-Launcher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "KaueBerto",
      "repo": "hollow-launcher",
      "releaseType": "release"
    }
  }
}
