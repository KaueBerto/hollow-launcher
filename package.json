{
  "name": "hollow-launcher",
  "version": "2.3.4",
  "description": "Launcher Electron do Hollow SMP para Windows",
  "author": "Hollow SMP",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "build": "electron-builder --win nsis --x64 --publish never",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.hollowsmp.launcher",
    "productName": "Hollow Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*.cjs",
      "renderer/**/*",
      "assets/logo_smp.png",
      "assets/end-background.png",
      "assets/hollow.ico",
      "assets/Monocraft*.ttf",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/automodpack-5.0.0-rc.2.jar",
        "to": "assets/automodpack-5.0.0-rc.2.jar"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD-PARTY.txt",
        "to": "THIRD-PARTY.txt"
      },
      {
        "from": "assets/hollow-pack-preflight.jar",
        "to": "assets/hollow-pack-preflight.jar"
      },
      {
        "from": "java/preflight",
        "to": "preflight-source"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/hollow.ico",
      "artifactName": "HollowSMP-Launcher-Setup-${version}.exe",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "KaueBerto",
      "repo": "hollow-launcher",
      "releaseType": "release"
    }
  }
}
